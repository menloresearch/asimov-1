<mujoco model="asimov_1_25dof">
  <compiler angle="radian" meshdir="../meshes" autolimits="true"/>

  <!-- Standalone physics options for the browser viewer (the training sim sets these in Python). -->
  <option integrator="implicitfast" solver="Newton" iterations="10" ls_iterations="20" timestep="0.005" noslip_iterations="5" impratio="10" cone="elliptic"/>

<default>
  <!-- REMOVED: frictionloss and damping were adding extra dissipation
       on top of PD controller KD. All damping now comes from actuator config only. -->
  <joint frictionloss="0"/>

  <default class="motor">
    <joint damping="0"/>  <!-- PD controller provides all damping via KD -->
  </default>

  <!-- Passive upper body joints: damped springs that return to rest position -->
  <!-- Like booster_gym T1: arms are not actively controlled, just passively stabilized -->
  <!-- Increased stiffness/damping to prevent flailing and self-collisions -->
  <default class="passive_upper">
    <joint damping="15.0" stiffness="80.0" springref="0"/>
  </default>

  <default class="visual">
    <geom material="visual_grey" contype="0" conaffinity="0" group="2" density="0"/>
  </default>

  <default class="collision">
    <geom group="3" rgba=".2 .6 .2 .3" type="capsule" contype="1" conaffinity="1" priority="1" condim="6"/>
    <default class="foot_capsule">
      <geom type="capsule" size="0.005" condim="3" friction="0.6"/>
    </default>
    <default class="body_capsule">
      <geom type="capsule" size="0.05"/>
    </default>
  </default>
</default>

  <visual>
    <global offwidth="1920" offheight="1080"/>
  </visual>

