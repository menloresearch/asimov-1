/dts-v1/;
/plugin/;

/ {
    fragment@0 {
        target = <&spi0>;
        __overlay__ {
            status = "okay";
            num-cs = <2>;
            pinctrl-names = "default";
            pinctrl-0 = <&spi0m2_pins &mcp2518_spi0_cs0 &mcp2518_spi0_cs1>;
            #address-cells = <1>;
            #size-cells = <0>;
            max-freq = <20000000>;

            cs-gpios = <&gpio3 21 1>, <&gpio4 0 1>;

            can0: mcp2518fd@0 {
                status = "okay";
                compatible = "microchip,mcp2518fd";
                reg = <0>;
                spi-max-frequency = <20000000>;

                pinctrl-names = "default";
                pinctrl-0 = <&mcp2518_spi0_int0>; 

                interrupt-parent = <&gpio4>;
                interrupts = <2 2>;

                clocks = <&can_clock>;
                vdd-supply = <&vcc_3v3_s3>;
                xceiver-supply = <&vcc_3v3_s3>;
            };
            can1: mcp2518fd@1 {
                status = "okay";
                compatible = "microchip,mcp2518fd";
                reg = <1>;
                spi-max-frequency = <20000000>;
                
                pinctrl-names = "default";
                pinctrl-0 = <&mcp2518_spi0_int1>; 

                interrupt-parent = <&gpio4>;
                interrupts = <1 2>;

                clocks = <&can_clock>;
                vdd-supply = <&vcc_3v3_s3>;
                xceiver-supply = <&vcc_3v3_s3>;
            };
        };
    };

    fragment@1 {
        target = <&spi1>;
        __overlay__ {
            status = "okay";
            num-cs = <2>;
            pinctrl-names = "default";
            pinctrl-0 = <&spi1m2_pins &mcp2518_spi1_cs0 &mcp2518_spi1_cs1>;
            #address-cells = <1>;
            #size-cells = <0>;
            max-freq = <20000000>;

            cs-gpios = <&gpio4 4 1>, <&gpio0 27 1>;

            can2: mcp2518fd@0 {
                status = "okay";
                compatible = "microchip,mcp2518fd";
                reg = <0>;
                spi-max-frequency = <20000000>;

                pinctrl-names = "default";
                pinctrl-0 = <&mcp2518_spi1_int0>; 

                interrupt-parent = <&gpio4>;
                interrupts = <5 2>;

                clocks = <&can_clock>;
                vdd-supply = <&vcc_3v3_s3>;
                xceiver-supply = <&vcc_3v3_s3>;
            };
            can3: mcp2518fd@1 {
                status = "okay";
                compatible = "microchip,mcp2518fd";
                reg = <1>;
                spi-max-frequency = <20000000>;
                
                pinctrl-names = "default";
                pinctrl-0 = <&mcp2518_spi1_int1>; 

                interrupt-parent = <&gpio0>;
                interrupts = <28 2>;

                clocks = <&can_clock>;
                vdd-supply = <&vcc_3v3_s3>;
                xceiver-supply = <&vcc_3v3_s3>;
            };
        };
    };

    fragment@2 {
        target = <&spi4>;
        __overlay__ {
            status = "okay";
            num-cs = <2>;
            pinctrl-names = "default";
            pinctrl-0 = <&spi4m0_pins &mcp2518_spi4_cs0 &mcp2518_spi4_cs1>;
            #address-cells = <1>;
            #size-cells = <0>;
            max-freq = <20000000>;

            cs-gpios = <&gpio4 7 1>, <&gpio0 18 1>;

            can4: mcp2518fd@0 {
                status = "okay";
                compatible = "microchip,mcp2518fd";
                reg = <0>;
                spi-max-frequency = <20000000>;

                pinctrl-names = "default";
                pinctrl-0 = <&mcp2518_spi4_int0>; 

                interrupt-parent = <&gpio4>;
                interrupts = <13 2>;

                clocks = <&can_clock>;
                vdd-supply = <&vcc_3v3_s3>;
                xceiver-supply = <&vcc_3v3_s3>;
            };
            can5: mcp2518fd@1 {
                status = "okay";
                compatible = "microchip,mcp2518fd";
                reg = <1>;
                spi-max-frequency = <20000000>;
                
                pinctrl-names = "default";
                pinctrl-0 = <&mcp2518_spi4_int1>; 

                interrupt-parent = <&gpio4>;
                interrupts = <6 2>;

                clocks = <&can_clock>;
                vdd-supply = <&vcc_3v3_s3>;
                xceiver-supply = <&vcc_3v3_s3>;
            };
        };
    };

    fragment@9 {
        target = <&pinctrl>; 
        __overlay__ {
            mcp2518 {
                mcp2518_spi0_int0: mcp2518-spi0-int0 {
                    rockchip,pins = <4 2 0 &pcfg_pull_none>; 
                };
                mcp2518_spi0_int1: mcp2518-spi0-int1 {
                    rockchip,pins = <4 1 0 &pcfg_pull_none>; 
                };
                mcp2518_spi0_cs0: mcp2518-spi0-cs0 {
                    rockchip,pins = <3 21 0 &pcfg_pull_up_drv_level_5>;
                };
                mcp2518_spi0_cs1: mcp2518-spi0-cs1 {
                    rockchip,pins = <4 0 0 &pcfg_pull_up_drv_level_5>;
                };
                mcp2518_spi1_int0: mcp2518-spi1-int0 {
                    rockchip,pins = <4 5 0 &pcfg_pull_none>; 
                };
                mcp2518_spi1_int1: mcp2518-spi1-int1 {
                    rockchip,pins = <0 28 0 &pcfg_pull_none>; 
                };
                mcp2518_spi1_cs0: mcp2518-spi1-cs0 {
                    rockchip,pins = <4 4 0 &pcfg_pull_up_drv_level_5>;
                };
                mcp2518_spi1_cs1: mcp2518-spi1-cs1 {
                    rockchip,pins = <0 27 0 &pcfg_pull_up_drv_level_5>;
                };
                mcp2518_spi4_int0: mcp2518-spi4-int0 {
                    rockchip,pins = <4 13 0 &pcfg_pull_none>; 
                };
                mcp2518_spi4_int1: mcp2518-spi4-int1 {
                    rockchip,pins = <4 6 0 &pcfg_pull_none>; 
                };
                mcp2518_spi4_cs0: mcp2518-spi4-cs0 {
                    rockchip,pins = <4 7 0 &pcfg_pull_up_drv_level_5>;
                };
                mcp2518_spi4_cs1: mcp2518-spi4-cs1 {
                    rockchip,pins = <0 18 0 &pcfg_pull_up_drv_level_5>;
                };
            };
        };
    };

    fragment@10 {
        target-path = "/";
        __overlay__ {
            can_clock: can-clock {
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency  = <40000000>;
            };
        };
    };

    fragment@11 {
        target = <&i2c7>;
        __overlay__ {
            status = "okay";
            pinctrl-0 = <&i2c7m2_xfer>;
        };
    };
};

