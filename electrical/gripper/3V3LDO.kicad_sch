	(text "Notes\n\n1.	TPS74501 LDO\n	-	Max current sinking\n		>	Voltage drop: 1.7V\n		>	RθJC: 80.3\n		>	Max allowable Temperature rise: 50\n		>	Max current: 0.35A\n	-	EN is wired directly to 5V to always power the LDO\n	-	Power good function\n		>	PG_{HTH} is 95% of VOUT (3V3)\n		>	PG is an open-drain output that becomes high impedance when VOUT rises above 95% of 3V3 and opens when VOUT falls below 92% of 3V3\n		>	PG sinks 0.033mA of current. Logic low is around 0.03V\n2.	TPS22995 load switch\n	-	This load switch is used to gate the 3V3 rail until it is ready\n	-	CT is set at 0pF (unconnected). Rise time is hence 72.2us\n	-	ON has a low threshold of 0.35V and a high threshold of 0.8V"
		(exclude_from_sim no)
		(at 17.272 41.656 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4fa9fd06-1a58-4b94-a6a0-62fe2039f3be")
	)
